{
  "name": "use complete I-Regexp categories in GOESSNER_EXTENDED",
  "obj": {
    "items": [
      { "name": "letter", "value": "é中", "pattern": "\\p{L}+" },
      { "name": "number", "value": "١Ⅷ²", "pattern": "\\p{N}+" },
      { "name": "separator", "value": " ", "pattern": "\\p{Z}" },
      { "name": "not-letter", "value": "1", "pattern": "\\p{L}" }
    ]
  },
  "expr": "$.items[?match(@.value, @.pattern)].name",
  "arg": {
    "mode": "GOESSNER_EXTENDED"
  },
  "expected": [
    "letter",
    "number",
    "separator"
  ]
}
